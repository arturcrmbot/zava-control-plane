  },
  "essay_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/blueprint/",
  "operator_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/",
  "operator_workflow_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/workflows/API-0004",
  "operator_memory_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/memory",
  "operator_knowledge_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/knowledge",
  "constellation_view_url": "https://zava-zava-verify-fruocco.thankfulsand-2576b58e.swedencentral.azurecontainerapps.io/blueprint/?view=constellation",
  "constellation_site_url": "https://aiappsgbb.github.io/zava-constellation/",
  "scenes": [
    {
      "id": "scene-01",
      "label": "Hook + setup",
      "text": "This is a piece I wrote about why most agent strategies aren't compounding. Every new initiative rebuilds the same plumbing from scratch: skills, adapters, audit, governance. After a year, instead of a platform, you have a graveyard of prototypes. The alternative is a shared substrate every initiative inherits.",
      "audio_ms": 19198,
      "stage": {
        "page": "essay",
        "after_navigate_wait_ms": 1500,
        "scroll_sequence": [
          {
            "to_text": "Each of these initiatives is a hand-copied manuscript",
            "align": "center",
            "wait_ms": 3500
          },
          {
            "to_text": "What we have already cast",
            "align": "start",
            "wait_ms": 0
          }
        ],
        "chyron": {
          "text": "aka.ms/agenticblueprint"
        }
      }
    },
    {
      "id": "scene-03a",
      "label": "Harness",
      "text": "The substrate is four pieces. The harness keeps determinism where it matters, with agentic segments only inside narrow bands. You never bet a whole workflow on the model behaving.",
      "audio_ms": 11302,
      "stage": {
        "page": "essay",
        "scroll_to_text": "What you ought to be using instead",
        "scroll_align": "start",
        "highlight_card_index": 0
      }
    },
    {
      "id": "scene-03b",
      "label": "Skills",
      "text": "Skills are markdown files. One team owns them, every workflow uses them.",
      "audio_ms": 6554,
      "stage": {
        "page": "essay",
        "highlight_card_index": 1
      }
    },
    {
      "id": "scene-03c",
      "label": "MCPs",
      "text": "MCPs are adapters, one per outside system, shared across every agent. Connect once, every workflow inherits the connection.",
      "audio_ms": 8600,
      "stage": {
        "page": "essay",
        "highlight_card_index": 2
      }
    },
    {
      "id": "scene-03d",
      "label": "Foundation",
      "text": "And the foundation: identity, validation, audit, policy, all in a single YAML file. Compliance gets one surface to look at, not one per project.",
      "audio_ms": 10331,
      "stage": {
        "page": "essay",
        "highlight_card_index": 3
      }
    },
    {
      "id": "scene-04",
      "label": "Reference org",
      "text": "Built it out as a reference organisation: 35 skills, 23 adapters, 10 workflows wired end to end. None of the skills or adapters belong to a single workflow.",
      "audio_ms": 10591,
      "stage": {
        "page": "essay",
        "scroll_to_text": "What we have already cast",
        "scroll_align": "start"
      }
    },
    {
      "id": "scene-05",
      "label": "AGT decisions",
      "text": "The foundation includes a delegated-authority matrix: a single JSON file with one rule per approval action — who signs off, at what threshold, what the escalation path is. Agents never decide on their own. They look up the rule, route accordingly, and the matched rule lands in the audit log next to the agent's reasoning.",
      "audio_ms": 18836,
      "stage": {
        "page": "essay",
        "scroll_to_text": "The delegated-authority matrix",
        "scroll_align": "start"
      }
    },
    {
      "id": "scene-06",
      "label": "Memory",
      "text": "This is the substrate's memory. Every run leaves a trace, organised by domain. Look at the hiring entries: persona, decision, the signals that drove it. When the next hiring workflow opens, the substrate finds the most relevant past entries and splices them into the agent's context. After enough runs, the agent acts as if it has been doing this job for years, because in aggregate it has.",
      "audio_ms": 24073,
      "stage": {
        "page": "operator_memory",
        "after_navigate_wait_ms": 4000
      }
    },
    {
      "id": "scene-07",
      "label": "Knowledge graph",
      "text": "Underneath the per-domain memory sits a shared knowledge graph. People, money, decisions, entities — all in one connected picture. Every workflow projects what it touches onto the graph, so when an HR director opens a training request, the substrate already knows which trainings that person approved before, and what came of them.",
      "audio_ms": 19257,
      "stage": {
        "page": "operator_knowledge",
        "after_navigate_wait_ms": 4000
      }
    },
    {
      "id": "scene-08",
      "label": "Observatory",
      "text": "This is the substrate running. The graph in the middle plots one workflow's structure: domain at the centre, skills around it, MCP calls out to the rim. Each blink is a real event. Counters tally workflows started, skills run, calls made, validators blocked, completions. Replayed telemetry from real runs against the same orchestrator described above.",
      "audio_ms": 27203,
      "stage": {
        "page": "essay",
        "scroll_to_text": "And here is what it looks like when it runs",
        "scroll_align": "start"
      }
    },
    {
      "id": "scene-09",
      "label": "One iteration",
      "text": "Operator dashboard, a workflow mid-flight. AP invoice from Globex, two hundred and ninety five thousand pounds. The drawer shows what the agent did, the authority rule that fired, why it suspended for human approval, the audit trail and the state snapshot. All on one page.",
      "audio_ms": 18320,
      "stage": {
        "page": "operator_workflow",
        "after_navigate_wait_ms": 4000
      }
    },
    {
      "id": "scene-10",
      "label": "Constellation view",
      "text": "And here is the whole organisation at once. Ten departments, around 35 domains, every active workflow visible. 142 cases moving right now, one waiting on a person. The same substrate, scaled to every corner of the business.",
      "audio_ms": 17114,
      "stage": {
        "page": "constellation_view",
        "after_navigate_wait_ms": 5000
      }
    },
    {
      "id": "scene-11",
      "label": "Clone it with skills",
      "text": "Everything you've just seen — the orchestrator, the personas, the operator surface, the constellation — is itself written as skills. Tell the coding agent the name of a company, and three skills profile it, fork the substrate with their brand and rules, and deploy it to Azure. To clone the whole thing for yourself, go to aiappsgbb.github.io/zava-constellation.",
      "audio_ms": 27654,
      "stage": {
        "page": "constellation_site",
        "after_navigate_wait_ms": 4000,
        "chyron": {
          "text": "aiappsgbb.github.io/zava-constellation"
        }
      }
    }
  ]
}
