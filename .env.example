# ── FastAPI + Functions (Python) ──────────────────────────────────
PORT=3101
# CORS allowlist for the FastAPI apps (api.server.main, api.server.blueprint_app).
# Comma-separated origins; whitespace is stripped. Wildcards are NOT supported.
# Default (when unset) covers the local vite dev servers + the FastAPI host:
#   http://localhost:5274,http://localhost:5275,http://localhost:3101
CORS_ALLOWED_ORIGINS=http://localhost:5274,http://localhost:5275,http://localhost:3101
FUNCTIONS_HOST=http://localhost:7071
WORKDAY_MCP_URL=http://localhost:4101
D365_MCP_URL=http://localhost:4102
MACONOMY_MCP_URL=http://localhost:4103
PAYMENT_MCP_URL=http://localhost:4104
# Delegated authority matrix MCP (Phase 1 of feature-authority-and-personae-1).
# Backed by mocks/authority-mcp/ (port 4108) over data/synthetic/authority/matrix.json.
# Engagement-POC: point at a Foundry IQ-backed endpoint to swap the data without
# touching skill or persona code.
AUTHORITY_MCP_URL=http://localhost:4108
FLEET_MANAGER_MODEL=gpt-4.1
# Domain-aware steady-state ramp (substrate-fix v2). Default ON.
#   ENABLED=0 → disable; spawn workflows by hand via /api/simulator/{inject,hire,travel}
#   AVG_INTERVAL_SECONDS → seconds between spawns per domain (default 90, ±30% jitter)
#   DOMAINS → CSV of domains; default all live domains
# DEMO DEFAULT (2026-05-07): POC1 only at ~60s cadence so the operator can
# walk through expense-claim end-to-end without other domains polluting
# the queue. Source scripts/profile-everything.sh to flip every domain on.
SIMULATOR_RAMP_ENABLED=1
SIMULATOR_RAMP_AVG_INTERVAL_SECONDS=60
SIMULATOR_RAMP_DOMAINS=expense-claim

# Portal seed: 3 HIRE-DEMO-* workflows that pre-attach hiring orchestrators
# so /apply has a target. For the demo we drive POC2 manually instead, so
# leave this off; flip to 1 with profile-everything.sh for unattended runs.
PORTAL_SEED_REQS=0

# Persona auto-close allow-list (CSV of persona roles). Default empty —
# every gate stays open, real human drives. For autonomous demos, list
# every persona you want the responder to auto-decide for.
# DEMO DEFAULT (2026-05-07): EMPTY. Nothing auto-resolves on POC1 or
# POC2 — the operator drives every gate through the UI. The finale
# profile (source scripts/profile-everything.sh) flips this back on
# for every persona on every domain.
PERSONA_AUTO_CLOSE=
# Azure Monitor / Foundry App Insights — OTEL export target (Foundry Tracing tab).
# Leave unset locally to make init_otel a no-op. To enable, fetch via:
#   project_client.telemetry.get_application_insights_connection_string()
# (the Foundry project's *Tracing* pane connects an App Insights resource to
# the project; the SDK then returns its conn string).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Capture prompts + responses on `gen_ai.response` span events so Foundry
# Tracing shows model content. SAFE ONLY FOR SYNTHETIC DATA — do NOT set this
# in any environment that handles real PII.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Append-only audit ledger backing storage account (TASK-024). When set, every
# audit_logger.log() call dual-writes to an append blob (one per workflow_id)
# in container AZURE_STORAGE_AUDIT_CONTAINER (default: audit-ledger). Auth via
# DefaultAzureCredential. Unset → in-memory only.
AZURE_STORAGE_AUDIT_ACCOUNT=
AZURE_STORAGE_AUDIT_CONTAINER=audit-ledger

# --- Azure AI Foundry evaluation (api/server/eval/*) ---
# Two distinct env vars:
#  1. Project URI (full URL ending in /api/projects/<name>) for
#     `evaluate(azure_ai_project=...)` and safety evaluators.
#  2. Azure OpenAI endpoint (base, no /api/projects/...) for LLM-judge
#     evaluators (Groundedness, Similarity, etc.) — call it through a deployed
#     judge model (e.g. gpt-4o).
# Auth uses DefaultAzureCredential (az login locally; managed identity in cloud).
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Embedding deployment used by Mem0LessonStore (vector store for distilled
# lessons). Must be a text-embedding-3-large deployment on the same
# Cognitive Services account as AZURE_OPENAI_ENDPOINT. When unset,
# Mem0LessonStore raises and api/server/state.py falls back to
# InMemoryLessonStore (lessons do NOT persist across restarts).
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Sampling rate for online evals (0.0 - 1.0). 1.0 = score every agent invocation.
# Defaults to 1.0 for demos; recommend 0.1 for sustained soak.
EVAL_SAMPLE_RATE=1.0

# Drain queue capacity. At capacity, oldest pending row is dropped (visible at
# /api/evals/health). Defaults to 1000.
EVAL_QUEUE_MAX=1000

# --- Azure AI Document Intelligence (ocr_extract MCP tool) ---
# Read by api/server/mcp_tools/ocr_extract.py. Auth uses Entra ID via
# DefaultAzureCredential — `az login` locally, managed identity in cloud.
# The signed-in identity needs the "Cognitive Services User" role on the resource.
# Tenant policy disables key-based auth on Cognitive Services, so no KEY var.
# Leave unset and ocr_extract returns a failure ToolResult with a clear error.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# --- Foundry judge model (separate from AZURE_OPENAI_DEPLOYMENT for clarity) ---
# api/server/eval/evaluator_set.py reads this for the LLM-judge instances
# (Groundedness, Relevance, Coherence, Similarity). Defaults to the value of
# AZURE_OPENAI_DEPLOYMENT when unset.
AZURE_FOUNDRY_JUDGE_MODEL_DEPLOYMENT=

# --- Candidate portal (web/portal/ + api/server/routes/portal.py) ---
# Azure Storage account connection string. Used by services/blob_store.py for
# CV uploads and HeyGen rendered mp4 cache. Local dev points at Azurite.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEEcrn8gNXBNHZTpaKE9LXVUcXg/p4axyW3PYsoGTcJ2VVQpRzD5pSlUL/RcQfA==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# ACS Email — magic-link delivery to candidates. Leave both unset to fall back
# to the local outbox under data/.portal/outbox/.
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER_ADDRESS=
# Public base URL of the candidate portal Vite app. The backend embeds this in
# magic-link emails. Local dev: http://localhost:5274.
PORTAL_BASE_URL=http://localhost:5274

# --- Azure AI Speech avatar batch synthesis (api/server/mcp_tools/avatar_render.py) ---
# When AZURE_SPEECH_REGION + AZURE_STORAGE_CONNECTION_STRING are set, the MCP
# tool calls the real Azure Speech batch avatar synthesis API and caches mp4s
# in Blob. Otherwise the tool returns a failure ToolResult and the
# orchestration falls back to the canned mp4 from mocks/heygen-mcp.
# Auth uses DefaultAzureCredential (az login locally; managed identity in
# cloud). The signed-in identity needs the "Cognitive Services Speech User"
# role on the Speech resource. Tenant policy disables key-based auth on
# Cognitive Services, so no KEY var.
AZURE_SPEECH_REGION=
# Override transport: real | mock. Defaults to real when configured.
AVATAR_TRANSPORT=real

# --- POC3 creative-campaign image generation (api/server/mcp_tools/image_gen.py) ---
# When CREATIVE_REAL_FOUNDRY=1 AND AZURE_OPENAI_ENDPOINT + AZURE_STORAGE_CONNECTION_STRING
# are set, the image_gen MCP tool calls real Foundry gpt-image-2 and caches
# PNGs in Azure Blob (container: creative-campaign-images). Otherwise the
# tool returns a structured failure and agent_creative_stub falls back to
# the canned SVG fixtures under data/synthetic/creative-campaign/cached/.
# Auth: same DefaultAzureCredential path as the rest of Foundry. Signed-in
# identity needs "Cognitive Services OpenAI User" on the Foundry resource.
# Cost: low ~$0.011/img, medium ~$0.042/img (default), high ~$0.167/img.
# A full creative-campaign demo renders 18 images (12 concept + 6 storyboard);
# at medium ~$0.75/run before the per-prompt cache kicks in.
CREATIVE_REAL_FOUNDRY=0
# Optional overrides — sensible defaults baked in.
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
CREATIVE_IMAGE_QUALITY=medium
CREATIVE_IMAGE_SIZE=1024x1024

# --- Voice screen (api/server/routes/portal_voice.py - native WebRTC bridge) ---
# When configured, /api/portal/voice/session mints an ephemeral GPT-Realtime
# session key for the browser; /api/portal/voice/rtc proxies the SDP exchange.
# The browser opens a real WebRTC peer connection — no iframes, no separate
# accelerator server.
# Get these from your Azure OpenAI resource that has the gpt-realtime deployment.
# Auth: prefer AZURE_GPT_REALTIME_KEY when set, fall back to DefaultAzureCredential.
AZURE_GPT_REALTIME_URL=
AZURE_GPT_REALTIME_DEPLOYMENT=gpt-realtime-1.5
AZURE_GPT_REALTIME_KEY=
WEBRTC_URL=
# `alloy` is gender-ambiguous and the model drifts in pitch/timbre between
# turns. Pin to a stable gendered voice (`coral` feminine, `verse` / `ash`
# masculine) so the interviewer sounds like one person across the call.
AZURE_REALTIME_VOICE=coral
# Override transport: accelerator | canned. Default uses native WebRTC. Set to
# "canned" to short-circuit /screen to a one-button canned-transcript path
# (useful for environments without mic / Azure access).
VOICE_TRANSPORT=accelerator

# ── Vite (React UI) ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3101

# Demo time-warp multiplier for per-domain spawn cadence.
# Effective interval = api/shared/domains.py:realistic_interval_seconds / DEMO_TIME_WARP_FACTOR.
# 60 = 1 real-world day collapses to 24 minutes of demo (default, lively).
# 1 = real-world cadences (most domains never spawn during a session).
# 300 = stress-test mode.
DEMO_TIME_WARP_FACTOR=60

# Belt-and-braces cap on cosmic-lens / blueprint observatory throughput.
# Token-bucket dropper in api/server/routes/blueprint.py. Default 20/sec
# (1200/min) is well above steady-state (~4/sec); raise to 100+ if a
# specific demo wants every burst event surfaced.
MAX_OBSERVATORY_EVENTS_PER_SEC=20

# --- POC2 hiring MCP endpoints (api/functions/graphs/_common.py) ---
# URLs for the mocked external systems the hiring graph calls. Defaults
# match docker-compose / mocks/* port assignments.
GREENHOUSE_MCP_URL=http://localhost:4201
LINKEDIN_MCP_URL=http://localhost:4202
WORKDAY_HR_MCP_URL=http://localhost:4203
GRAPH_MCP_URL=http://localhost:4204
SERVICENOW_MCP_URL=http://localhost:4205
ACS_MCP_URL=http://localhost:4206
HEYGEN_MCP_URL=http://localhost:4207

# --- Functions → FastAPI webhook (api/functions/webhook.py) ---
# Where Durable Functions POST workflow events back to the FastAPI server.
FASTAPI_WEBHOOK_URL=http://localhost:3101/internal/durable-event

# --- Inbound webhook HMAC secrets (§4.6) ---
# Shared secrets used by api/server/services/webhook_auth.py to verify the
# X-ServiceNow-Signature / X-Finance-BP-Signature / X-Durable-Event-Signature
# headers (HMAC-SHA256 hex digest over the raw request body). Missing/empty
# → all calls 401.
# DURABLE_EVENT_SECRET gates /internal/durable-event (Functions-host →
# FastAPI bridge); api/functions/webhook.py auto-signs when this is set.
# Production: source from Key Vault.
SERVICENOW_WEBHOOK_SECRET=
FINANCE_BP_WEBHOOK_SECRET=
DURABLE_EVENT_SECRET=

# --- Portal orchestration tunables ---
# Score cutoff (0.0-1.0) above which a candidate is auto-shortlisted.
# Read by api/server/services/portal_orchestration.py.
SHORTLIST_THRESHOLD=
# Blob container name overrides for portal artefacts.
# api/server/state.py (CV uploads) and
# api/functions/graphs/executors/agents/agent_offer_personaliser.py (offers).
PORTAL_CV_CONTAINER=portal-cvs
PORTAL_OFFERS_CONTAINER=portal-offers

# --- Entity plane toggle (api/server/state.py) ---
# Set to "0" to disable the entity plane (e.g. inside the Functions host
# during boot-demo.sh). Default "1" preserves prior behaviour.
ENTITY_PLANE_ENABLED=1

# --- Agent governance toolkit (plan/feature-agent-governance-toolkit-1.md) ---
# AGT_ENFORCE flips the kernel from log-only (records every deny but never
# raises) to enforce (raises GovernanceDenied). Default "0" (log-only).
# AGT_DEFAULT_ACTOR labels un-attributed call_mcp() invocations.
AGT_ENFORCE=0
AGT_DEFAULT_ACTOR=unknown-agent

# --- Read-route actor gate (services/read_route_auth.py) ---
# Sensitive read surfaces (audit, evals, entities, cities) require an
# actor on every request. Default (unset / anything other than "enforce")
# is local-PoC ergonomics: a synthetic "local-dev" actor is stamped so
# handlers always have an Actor. Set to "enforce" to require an
# X-Actor-Id header (optionally X-Actor-Role) — missing → 401. The
# projector also redacts prompt/response fields for roles other than
# cfo / gc on audit + entity payloads.
READ_ROUTE_AUTH=

# === Agency vertical pack ===
# Hand-crafted mocks under mocks/<system>-mcp/ that back the pitch-readiness
# enterprise stack. Boot them with BOOT_DEMO_WITH_AGENCY_MOCKS=1 (off by
# default) or `npm run demo:mcp:agency`. Ports live in the 4200-4299 range.
SALESFORCE_MCP_URL=http://localhost:4200
MEDIAOCEAN_MCP_URL=http://localhost:4221
PRISMA_MCP_URL=http://localhost:4222
DOCUSIGN_MCP_URL=http://localhost:4226
SAP_S4_FINANCE_MCP_URL=http://localhost:4224
KINESSO_MCP_URL=http://localhost:4223
WORKDAY_HCM_MCP_URL=http://localhost:4225

# pitch-e5 — fire every cadenced ritual once on first scheduler tick
# instead of waiting for its real cron (e.g. Monday 09:00 for the weekly
# pitch review). Useful for live demos so the rituals are visible
# immediately. Honour cron when 0 (default), burst once when 1.
SIMULATOR_CADENCE_BURST=0
