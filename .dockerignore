# Send only what the blueprint deploy needs to the Docker build context.
# This stays at the repo root because docker build always starts from the
# repo root (the Dockerfile lives at web/blueprint/Dockerfile but pulls
# files from across the tree).

# --- Heavy dev artefacts -------------------------------------------------
# NOTE: bare names (no trailing slash) so the patterns also match in the
# `az acr build` upload tar, not just inside the Docker build context.
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/dist
**/build
**/*.egg-info
**/.tsbuildinfo
**/.vite

# Single-stage deploy ships the locally-built blueprint bundle.
!web/blueprint/dist
!web/blueprint/dist/**

# --- Local state ---------------------------------------------------------
azurite-data/
azurite-data/__azurite_db_blob_extent__.json
azurite-data/__blobstorage__/
azurite-data/__queuestorage__/
data/portal/
data/.eval/
data/.avatar/
.env
.env.local
local.settings.json
**/local.settings.json
*.log
logs/

# --- Bulky source not needed by the runtime image
.azure/
.azurite/
*.pptx
.playwright-cli/
.playwright-mcp/
.playwright/

# --- Per-user dev tooling ------------------------------------------------
.playwright/
.playwright-cli/
.playwright-mcp/
.claude/
.vscode/
.devcontainer/
.ipynb_checkpoints/

# --- Tests / docs / fixtures we don't need in the image ------------------
tests
docs
screenshots
tools/scratch
*.pptx
*.pdf

# --- Git + CI ------------------------------------------------------------
.git/
.github/
.gitignore
.gitattributes

# --- Editor noise --------------------------------------------------------
.DS_Store
*.swp
*.swo

# --- Misc images we don't need in the image ------------------------------
# Keep the blueprint Gutenberg PNG (under web/blueprint/public/) — it's
# served by the page. Other PNGs are local artefacts.
**/*.png
!web/blueprint/public/gutenberg.png
# Synthetic expense-claim receipts: required at runtime by the
# expense-claim orchestrator (api/server/mcp_tools/claim_get_receipt.py)
# and the receipt-serving FastAPI route. Without these, every claim
# fails Intake with `FileNotFoundError: receipt 'CLM-XXXX.png' not found`.
!data/synthetic/receipts/*.png
# Synthetic CV PDFs: required at runtime by the hiring orchestrator's
# ocr_extract tool and the portal route that streams candidate CVs.
!data/synthetic/hiring/cv-pdfs/*.pdf

# Re-include the entire built blueprint bundle (must come AFTER the
# **/*.png exclude above, otherwise dist/*.png gets dropped).
!web/blueprint/dist
!web/blueprint/dist/**
