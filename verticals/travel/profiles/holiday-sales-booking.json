  "phases": [
    {
      "kind": "deterministic",
      "name": "detect_demand"
    },
    {
      "kind": "agent",
      "name": "assess_quote"
    },
    {
      "kind": "deterministic",
      "name": "confirm_and_pay"
    }
  ],
  "skills": [
    "holiday-sales-booking"
  ],
  "tools": [
    "travel_operations_check_quote_offer",
    "travel_operations_reserve_package_capacity"
  ],
  "trigger": {
    "predicate": "a customer quote reaches status 'ready' with a live flight, hotel and transfer still holding availability",
    "sensor_id": "sensor:quote_ready",
    "threshold": "any quote whose status becomes 'ready'"
  },
  "workflow_type": "holiday-sales-booking"
