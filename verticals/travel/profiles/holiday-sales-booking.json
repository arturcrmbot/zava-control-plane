{
  "authority": {
    "approval_actions": [
      "confirm_package_booking"
    ],
    "approval_bound_gbp": 2000.0,
    "delegate_to": "head_of_commercial",
    "role": "travel_adviser",
    "spend_limit_gbp": 2000.0
  },
  "command": {
    "command_type": "confirm_package_booking",
    "required_fields": [
      "allotment_id",
      "authorized_by",
      "flight_id",
      "hotel_id",
      "quote_id",
      "rooms",
      "transfer_id"
    ]
  },
  "display_name": "Holiday Sales Booking",
  "evaluation_contract": {
    "evaluation_type": "booking_confirmed_and_paid",
    "evaluator_fn": "evaluate_booking_confirmed_and_paid"
  },
  "function": "commercial",
  "hero": false,
  "maturity": "graduated",
  "mutation_contract": {
    "evaluation_timeout_minutes": 60.0,
    "failure_event_types": [
      "command.rejected"
