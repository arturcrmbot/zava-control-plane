"""agent_{{DOMAIN_NAME_SNAKE}}_{{PHASE_NAME}} — invokes the {{DOMAIN_NAME}}-{{PHASE_NAME}} skill via the GHCP SDK.

Pass *only* the {{DOMAIN_NAME}}-{{PHASE_NAME}} skill directory to
`skill_directories` so multiple loaded skills don't fight over the output
schema. Tools are SDK-native (`@define_tool`), registered via `tools=[...]`,
and called autonomously by the model per the skill's `allowed-tools`
frontmatter. No prompt-stuffing.
"""
from __future__ import annotations

{{TOOL_IMPORTS}}

from ._wrapper import SKILLS_DIR, run_agent_session

_SKILL_DIR = SKILLS_DIR / "{{DOMAIN_NAME}}-{{PHASE_NAME}}"


async def execute(input: dict) -> dict:
    workflow_id = input.get("workflow_id")
    {{INPUT_EXTRACTIONS}}
    prompt = (
        {{PROMPT_LINES}}
    )
    result = await run_agent_session(
        prompt=prompt,
        tools=[{{TOOL_VARS}}],
        skill_dir=_SKILL_DIR,
        skill_label="{{DOMAIN_NAME}}-{{PHASE_NAME}}",
        workflow_id=workflow_id,
    )
    return {"{{PHASE_NAME}}": result}
