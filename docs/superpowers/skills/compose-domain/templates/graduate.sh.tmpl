#!/usr/bin/env bash
# Graduate {{DOMAIN_DISPLAY_NAME}} ({{DOMAIN_NAME}}) into the live trees.
#
# Generated by compose-domain v3 on {{TIMESTAMP_UTC}}.
# Sandbox: tools/scratch/compose-domain/{{RUN_ID}}/
#
# Idempotent: each step is a no-op if the change is already present.
# Run from repo root.
#
# What this does (one-line summary per step):
#   1. Validate prereqs.
#   2. Copy sandbox files into the real trees.
#   3. Patch function_app.py (orchestrator + activity decorators).
#   4. Patch api/functions/graphs/__init__.py (build_* exports).
#   5. Patch api/server/services/simulator_orchestrator.py (spawn helper +
#      ramp_loop spawners dict).
#   6. Patch api/server/routes/simulator.py (POST /api/simulator/{{DOMAIN_NAME}}).
#   7. Patch api/server/services/blueprint_inventory.py (DOMAINS entry).
#   8. Patch api/shared/constants.py (lift PHASE_TIMEOUT constants).
#   9. Patch api/shared/functions.py — append `{{WORKFLOW_TYPE}}` to
#      FUNCTIONS["{{FUNCTION_KEY}}"].owns_domains (idempotent via
#      sentinel `# compose-domain:owns_domains:{{FUNCTION_KEY}}`). Skipped
#      with a warn log if api/shared/functions.py does not yet exist
#      (Phase 3 will land that registry).
#  10. Print smoke commands + expected event sequence.
#
# Rollback if any step fails:
#   git checkout -- function_app.py api/functions/graphs/__init__.py \
#       api/server/services/simulator_orchestrator.py \
#       api/server/routes/simulator.py \
#       api/server/services/blueprint_inventory.py \
#       api/shared/constants.py \
#       api/functions/workflows/{{DOMAIN_NAME_SNAKE}}.py \
#       api/functions/workflows/{{DOMAIN_NAME_SNAKE}}_activities.py
#   rm -rf api/server/skills/{{DOMAIN_NAME}}-* \
#          api/server/personae/{{PERSONA_ROLES_SPACED}} \
#          api/functions/graphs/{{DOMAIN_NAME_SNAKE}}_*.py \
#          api/functions/graphs/executors/agents/agent_{{DOMAIN_NAME_SNAKE}}_*.py \
#          api/functions/graphs/executors/validators/validate_{{DOMAIN_NAME_SNAKE}}_*.py
#   {{REMOVE_NEW_TOOLS_BLOCK}}

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SBX="$(cd "$(dirname "$0")" && pwd)"

cd "$REPO_ROOT"
echo "==> repo root: $REPO_ROOT"
echo "==> sandbox:   $SBX"
echo ""

# --------------------------------------------------------------------------
# 1. Validate prereqs.
# --------------------------------------------------------------------------
echo "==> [1/10] Validating prereqs ..."
test -d api/server/skills || { echo "ERR: not a repo root (api/server/skills missing)"; exit 1; }
test -d "$SBX/api" || { echo "ERR: sandbox layout missing"; exit 1; }
echo "    ok"
echo ""

# --------------------------------------------------------------------------
# 2. Copy sandbox files (idempotent).
# --------------------------------------------------------------------------
echo "==> [2/10] Copying sandbox files ..."
{{COPY_FILES_BLOCK}}
echo "    copied"
echo ""

# --------------------------------------------------------------------------
# 3. Patch function_app.py.
#    Append imports + orchestrator decorator + activity decorators between
#    `# === BEGIN compose-domain {{DOMAIN_NAME}} ===` and matching END marker.
# --------------------------------------------------------------------------
echo "==> [3/10] Patching function_app.py ..."
if grep -q "BEGIN compose-domain {{DOMAIN_NAME}}" function_app.py; then
    echo "    already patched (skip)"
else
    cat >> function_app.py <<'EOF_FNAPP'

# === BEGIN compose-domain {{DOMAIN_NAME}} ===
{{FUNCTION_APP_IMPORTS}}


@app.orchestration_trigger(context_name="context")
def {{ORCHESTRATOR_CLASS_NAME}}(context: df.DurableOrchestrationContext):
    return {{DOMAIN_NAME_SNAKE}}_orchestration(context)


{{FUNCTION_APP_ACTIVITY_DECLS}}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_FNAPP
    echo "    patched"
fi
echo ""

# --------------------------------------------------------------------------
# 4. Patch api/functions/graphs/__init__.py (idempotent imports).
# --------------------------------------------------------------------------
echo "==> [4/10] Patching api/functions/graphs/__init__.py ..."
if grep -q "build_{{DOMAIN_NAME_SNAKE}}_" api/functions/graphs/__init__.py; then
    echo "    already patched (skip)"
else
    cat >> api/functions/graphs/__init__.py <<'EOF_GRAPHS'

# Generated by compose-domain v3: {{DOMAIN_NAME}}
{{GRAPHS_INIT_EXPORTS}}
EOF_GRAPHS
    echo "    patched"
fi
echo ""

# --------------------------------------------------------------------------
# 5. Patch api/server/services/simulator_orchestrator.py.
#    Append the spawn helper. Add the new domain to ramp_loop's spawners
#    dict (idempotent: skip if already in the dict literal).
# --------------------------------------------------------------------------
echo "==> [5/10] Patching simulator_orchestrator.py ..."
SIM_PATH="api/server/services/simulator_orchestrator.py"
if grep -q "spawn_{{DOMAIN_NAME_SNAKE}}_workflow" "$SIM_PATH"; then
    echo "    spawn helper already present (skip)"
else
    cat >> "$SIM_PATH" <<'EOF_SIM_HELPER'


# === BEGIN compose-domain {{DOMAIN_NAME}} ===
_{{DOMAIN_NAME_SNAKE_SHORT}}_seq = 0


async def spawn_{{DOMAIN_NAME_SNAKE}}_workflow(
{{SPAWN_HELPER_PARAMS}}
) -> str:
    """{{SPAWN_HELPER_DOCSTRING}}

    Note: generated domains do not currently upsert into app_state.store
    (the existing Workflow / ClaimData / HiringData types are domain-
    specific). State lives only in Durable + the FleetEvent stream.
    """
    global _{{DOMAIN_NAME_SNAKE_SHORT}}_seq
    _{{DOMAIN_NAME_SNAKE_SHORT}}_seq += 1
    wid = f"{{WORKFLOW_ID_PREFIX}}-{_{{DOMAIN_NAME_SNAKE_SHORT}}_seq:04d}"
    payload: dict = {
        "workflow_id": wid,
        "type": "{{WORKFLOW_TYPE}}",
{{SPAWN_HELPER_PAYLOAD}}
    }
    try:
        await schedule_new_orchestration(
            payload, function_name="{{ORCHESTRATOR_CLASS_NAME}}",
        )
    except Exception as ex:
        print(f"[orchestrator] failed to schedule {wid}: {ex}")
    return wid
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_SIM_HELPER
    echo "    spawn helper appended"
fi

# Add to ramp_loop spawners dict if not already there.
if grep -q '"{{WORKFLOW_TYPE}}": spawn_{{DOMAIN_NAME_SNAKE}}_workflow' "$SIM_PATH"; then
    echo "    ramp_loop spawners already includes {{WORKFLOW_TYPE}} (skip)"
else
    # Insert before the closing `}` of the spawners dict literal in ramp_loop.
    python3 - <<EOF_PY_RAMP
import re, sys
path = "$SIM_PATH"
with open(path) as f:
    src = f.read()
pattern = re.compile(
    r'(    spawners\s*=\s*\{[^}]*?)(\n    \})',
    re.DOTALL,
)
m = pattern.search(src)
if not m:
    print("WARN: could not find spawners dict literal in ramp_loop; skipping")
    sys.exit(0)
new_entry = '\n        "{{WORKFLOW_TYPE}}": spawn_{{DOMAIN_NAME_SNAKE}}_workflow,'
patched = src[:m.start(2)] + new_entry + src[m.start(2):]
with open(path, "w") as f:
    f.write(patched)
print("    patched ramp_loop spawners dict")
EOF_PY_RAMP
fi
echo ""

# --------------------------------------------------------------------------
# 6. Patch api/server/routes/simulator.py.
# --------------------------------------------------------------------------
echo "==> [6/10] Patching api/server/routes/simulator.py ..."
ROUTE_PATH="api/server/routes/simulator.py"
if grep -q '"/{{DOMAIN_NAME}}"' "$ROUTE_PATH" || grep -q "spawn_{{DOMAIN_NAME_SNAKE}}_workflow" "$ROUTE_PATH"; then
    echo "    already patched (skip)"
else
    # Append import + body class + route handler.
    cat >> "$ROUTE_PATH" <<'EOF_ROUTE'


# === BEGIN compose-domain {{DOMAIN_NAME}} ===
from api.server.services.simulator_orchestrator import (  # noqa: E402
    spawn_{{DOMAIN_NAME_SNAKE}}_workflow,
)


class {{DOMAIN_BODY_CLASS}}Body(BaseModel):
{{ROUTE_BODY_FIELDS}}


@router.post("/{{DOMAIN_NAME}}")
async def inject_{{DOMAIN_NAME_SNAKE}}(body: {{DOMAIN_BODY_CLASS}}Body):
    """Generated-domain simulator: spawn a {{DOMAIN_DISPLAY_NAME}} workflow."""
    workflow_id = await spawn_{{DOMAIN_NAME_SNAKE}}_workflow(
{{ROUTE_HANDLER_ARGS}}
    )
    return {"workflow_id": workflow_id}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_ROUTE
    echo "    patched"
fi
echo ""

# --------------------------------------------------------------------------
# 7. Patch api/server/services/blueprint_inventory.py.
# --------------------------------------------------------------------------
echo "==> [7/10] Patching blueprint_inventory.py ..."
INV_PATH="api/server/services/blueprint_inventory.py"
if grep -q '"name": "{{DOMAIN_DISPLAY_NAME}}"' "$INV_PATH"; then
    echo "    already patched (skip)"
else
    python3 - <<EOF_PY_INV
import re
path = "$INV_PATH"
with open(path) as f:
    src = f.read()
new_entry = '''    {
        "name": "{{DOMAIN_DISPLAY_NAME}}",
        "status": "live",
        "workflow_type": "{{WORKFLOW_TYPE}}",
        "skills": [
{{INVENTORY_SKILLS_LIST}}
        ],
        "phase_aliases": {
{{INVENTORY_PHASE_ALIASES}}
        },
    },
'''
# Insert before the first aspirational entry (Procurement is a stable marker).
marker = '    {\n        "name": "Procurement"'
if marker not in src:
    raise SystemExit("ERR: could not find Procurement aspirational marker in inventory")
patched = src.replace(marker, new_entry + marker, 1)
with open(path, "w") as f:
    f.write(patched)
print("    patched inventory DOMAINS list")
EOF_PY_INV
fi
echo ""

# --------------------------------------------------------------------------
# 8. Patch api/shared/constants.py — lift PHASE_TIMEOUT constants.
# --------------------------------------------------------------------------
echo "==> [8/10] Patching api/shared/constants.py ..."
CONST_PATH="api/shared/constants.py"
if grep -q "{{FIRST_TIMEOUT_NAME}}" "$CONST_PATH"; then
    echo "    already patched (skip)"
else
    cat >> "$CONST_PATH" <<'EOF_CONST'

# Generated by compose-domain v3: {{DOMAIN_NAME}}
{{TIMEOUT_CONSTANTS_BLOCK}}
EOF_CONST
    echo "    appended"
fi

# Update the orchestrator file to import from constants (idempotent).
ORCH_PATH="api/functions/workflows/{{DOMAIN_NAME_SNAKE}}.py"
if grep -q "from api.shared.constants import" "$ORCH_PATH" \
        | head -1 | grep -q "{{FIRST_TIMEOUT_NAME}}"; then
    echo "    orchestrator already imports timeouts from constants (skip)"
else
    python3 - <<EOF_PY_ORCH
import re
path = "$ORCH_PATH"
with open(path) as f:
    src = f.read()
# Remove local timedelta declarations.
src = re.sub(r"^[A-Z_]+_TIMEOUT\s*=\s*timedelta\([^)]*\)\s*\n", "", src, flags=re.MULTILINE)
# Add import after the existing `import azure.durable_functions as df`.
if "from api.shared.constants import" not in src:
    src = src.replace(
        "import azure.durable_functions as df\n",
        "import azure.durable_functions as df\n"
        "from api.shared.constants import (\n{{CONSTANTS_IMPORTED_NAMES_INDENTED}}\n)\n",
        1,
    )
with open(path, "w") as f:
    f.write(src)
print("    orchestrator imports lifted")
EOF_PY_ORCH
fi
echo ""

# --------------------------------------------------------------------------
# 9. Patch api/shared/functions.py — claim {{WORKFLOW_TYPE}} for
#    FUNCTIONS["{{FUNCTION_KEY}}"].owns_domains. Idempotent via the
#    sentinel `# compose-domain:owns_domains:{{FUNCTION_KEY}}`.
#
#    Guarded skip: if api/shared/functions.py is absent (Phase 3 not
#    yet merged), this step is a logged no-op and graduate.sh
#    continues. Phase 3's compose-domain integration will own the
#    file.
# --------------------------------------------------------------------------
echo "==> [9/10] Patching api/shared/functions.py ..."
FN_PATH="api/shared/functions.py"
FN_SENTINEL="# compose-domain:owns_domains:{{FUNCTION_KEY}}"
if [ ! -f "$FN_PATH" ]; then
    echo "    warn: $FN_PATH absent — skipping FUNCTIONS patch (Phase 3 will own this)"
elif grep -q "$FN_SENTINEL" "$FN_PATH" && grep -q "\"{{WORKFLOW_TYPE}}\"" "$FN_PATH"; then
    echo "    already patched ({{WORKFLOW_TYPE}} ∈ FUNCTIONS[\"{{FUNCTION_KEY}}\"].owns_domains)"
else
    python3 - <<EOF_PY_FN
import re, sys
path = "$FN_PATH"
with open(path) as f:
    src = f.read()
sentinel = "$FN_SENTINEL"
fn_key = "{{FUNCTION_KEY}}"
wt = "{{WORKFLOW_TYPE}}"

# Find FUNCTIONS["<fn_key>"].owns_domains list literal and append the
# workflow_type if not already present, marked with the sentinel.
# Tolerates either FUNCTIONS["x"] = X(owns_domains=["..."]) or
# FUNCTIONS["x"].owns_domains = [...] declaration shapes.
patterns = [
    re.compile(
        r'(FUNCTIONS\[' + re.escape(repr(fn_key)) + r'\][^\n]*owns_domains\s*=\s*\[)([^\]]*)(\])',
        re.DOTALL,
    ),
    re.compile(
        r'(FUNCTIONS\[' + re.escape(repr(fn_key)) + r'\]\s*=\s*[A-Za-z_][A-Za-z0-9_]*\([^)]*owns_domains\s*=\s*\[)([^\]]*)(\])',
        re.DOTALL,
    ),
]
m = None
for pat in patterns:
    m = pat.search(src)
    if m:
        break
if not m:
    print(f"    warn: could not locate FUNCTIONS[{fn_key!r}].owns_domains list literal — manual patch required")
    sys.exit(0)

inner = m.group(2)
if repr(wt) in inner or f'"{wt}"' in inner or f"'{wt}'" in inner:
    print("    already includes workflow_type (skip)")
    sys.exit(0)

inserted = (
    inner.rstrip().rstrip(",")
    + (",\n        " if inner.strip() else "        ")
    + repr(wt) + f",  {sentinel}\n    "
)
patched = src[:m.start(2)] + inserted + src[m.end(2):]
with open(path, "w") as f:
    f.write(patched)
print(f"    appended {wt!r} to FUNCTIONS[{fn_key!r}].owns_domains")
EOF_PY_FN
fi
echo ""

# --------------------------------------------------------------------------
# 10. Print smoke commands + expected event sequence.
# --------------------------------------------------------------------------
echo "==> [10/10] Done."
echo ""
echo "Smoke test (run after Functions host + FastAPI restart):"
echo ""
echo "  bash scripts/profile-autonomous.sh &     # or profile-friday.sh"
echo "  sleep 10"
echo "  curl -s -X POST http://localhost:3101/api/simulator/{{DOMAIN_NAME}} \\"
echo "       -H 'Content-Type: application/json' -d '{}'"
echo ""
echo "Expected FleetEvent sequence on /api/blueprint/stream:"
cat <<'EOF_EVENTS'
{{EXPECTED_EVENT_SEQUENCE}}
EOF_EVENTS
echo ""
echo "Then: record real walks for replay:"
echo ""
echo "  curl -X POST http://localhost:3101/api/blueprint/_recorder/start"
echo "  sleep 300"
echo "  curl -X POST http://localhost:3101/api/blueprint/_recorder/stop"
echo "  ls data/blueprint-recordings/{{WORKFLOW_TYPE}}-*.jsonl"
echo "  git add data/blueprint-recordings/{{WORKFLOW_TYPE}}-*.jsonl"
echo "  git commit -m 'record(blueprint): real walks for {{DOMAIN_DISPLAY_NAME}}'"
echo ""
echo "Then redeploy the container app: ./scripts/deploy-blueprint.sh"
