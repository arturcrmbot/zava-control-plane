#!/usr/bin/env bash
# Graduate {{DOMAIN_DISPLAY_NAME}} ({{DOMAIN_NAME}}) into one vertical pack.
#
# Generated by compose-domain on {{TIMESTAMP_UTC}}.
# Sandbox: tools/scratch/compose-domain/{{RUN_ID}}/
#
# Idempotent: every live-tree patch is sentinel guarded.
# Run from the repository root or from any child directory.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
SBX="$(cd "$(dirname "$0")" && pwd)"
VERTICAL="{{VERTICAL_NAME}}"
PACK_ROOT="verticals/$VERTICAL"
DURABLE_PATH="$PACK_ROOT/durable.py"
DOMAINS_PATH="$PACK_ROOT/domains.py"
FUNCTIONS_PATH="$PACK_ROOT/functions.py"
SPAWNERS_PATH="$PACK_ROOT/spawners.py"
MARKER="{{DOMAIN_NAME}}"

cd "$REPO_ROOT"

echo "==> vertical:  $VERTICAL"
echo "==> sandbox:   $SBX"
echo "==> pack root: $PACK_ROOT"

# --------------------------------------------------------------------------
# 1. Validate the selected pack and sandbox.
# --------------------------------------------------------------------------
echo "==> [1/6] Validating prerequisites ..."
test -f "$PACK_ROOT/manifest.py" || {
    echo "ERR: unknown vertical pack: $VERTICAL"
    exit 1
}
test -f "$DURABLE_PATH" || {
    echo "ERR: $VERTICAL pack has no Durable registration module"
    exit 1
}
test -f "$DOMAINS_PATH" || {
    echo "ERR: $VERTICAL pack has no domain registry"
    exit 1
}
test -f "$FUNCTIONS_PATH" || {
    echo "ERR: $VERTICAL pack has no function registry"
    exit 1
}
test -d "$SBX/api" || {
    echo "ERR: sandbox layout missing"
    exit 1
}

# --------------------------------------------------------------------------
# 2. Copy generated files.
#
# COPY_FILES_BLOCK must map business assets as follows:
#   api/server/skills/*              -> $PACK_ROOT/skills/
#   api/server/personae/*            -> $PACK_ROOT/personae/
#   api/server/mcp_tools/*.py        -> $PACK_ROOT/mcp_tools/
#   api/server/services/entity_projections/*.py
#                                    -> $PACK_ROOT/entity_projections/
#
# Workflow/graph implementation modules remain under api/functions/. Never
# copy a business asset into another vertical or a global legacy root.
# --------------------------------------------------------------------------
echo "==> [2/6] Copying generated files ..."
mkdir -p \
    "$PACK_ROOT/skills" \
    "$PACK_ROOT/personae" \
    "$PACK_ROOT/mcp_tools" \
    "$PACK_ROOT/entity_projections"
{{COPY_FILES_BLOCK}}

# --------------------------------------------------------------------------
# 3. Register orchestrator and activities on the selected pack's DFApp.
# --------------------------------------------------------------------------
echo "==> [3/6] Registering Durable functions ..."
if grep -q "BEGIN compose-domain $MARKER" "$DURABLE_PATH"; then
    echo "    already registered"
else
    cat >> "$DURABLE_PATH" <<'EOF_DURABLE'

# === BEGIN compose-domain {{DOMAIN_NAME}} ===
{{FUNCTION_APP_IMPORTS}}


@app.orchestration_trigger(context_name="context")
def {{ORCHESTRATOR_CLASS_NAME}}(context: df.DurableOrchestrationContext):
    return {{DOMAIN_NAME_SNAKE}}_orchestration(context)


{{FUNCTION_APP_ACTIVITY_DECLS}}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_DURABLE
fi

# --------------------------------------------------------------------------
# 4. Export generated graph builders from shared graph mechanisms.
# --------------------------------------------------------------------------
echo "==> [4/6] Registering graph builders ..."
GRAPHS_PATH="api/functions/graphs/__init__.py"
if grep -q "build_{{DOMAIN_NAME_SNAKE}}_" "$GRAPHS_PATH"; then
    echo "    already registered"
else
    cat >> "$GRAPHS_PATH" <<'EOF_GRAPHS'

# Generated by compose-domain: {{DOMAIN_NAME}}
{{GRAPHS_INIT_EXPORTS}}
EOF_GRAPHS
fi

# --------------------------------------------------------------------------
# 5. Register pack-owned spawner, domain, and function membership.
#
# The generated blocks append declarations to the selected pack modules.
# They must never patch api/shared compatibility adapters, function_app.py,
# Blueprint inventory, or another vertical.
# --------------------------------------------------------------------------
echo "==> [5/6] Registering pack business declarations ..."
touch "$SPAWNERS_PATH"

if ! grep -q "BEGIN compose-domain $MARKER" "$SPAWNERS_PATH"; then
    cat >> "$SPAWNERS_PATH" <<'EOF_SPAWNER'

# === BEGIN compose-domain {{DOMAIN_NAME}} ===
{{SPAWNER_REGISTRATION_BLOCK}}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_SPAWNER
fi

if ! grep -q "BEGIN compose-domain $MARKER" "$DOMAINS_PATH"; then
    cat >> "$DOMAINS_PATH" <<'EOF_DOMAIN'

# === BEGIN compose-domain {{DOMAIN_NAME}} ===
{{DOMAIN_DECLARATION_BLOCK}}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_DOMAIN
fi

if ! grep -q "BEGIN compose-domain $MARKER" "$FUNCTIONS_PATH"; then
    cat >> "$FUNCTIONS_PATH" <<'EOF_FUNCTION'

# === BEGIN compose-domain {{DOMAIN_NAME}} ===
{{FUNCTION_MEMBERSHIP_BLOCK}}
# === END compose-domain {{DOMAIN_NAME}} ===
EOF_FUNCTION
fi

# --------------------------------------------------------------------------
# 6. Validate the active pack and print smoke commands.
# --------------------------------------------------------------------------
echo "==> [6/6] Validating pack ..."
ZAVA_VERTICAL="$VERTICAL" python3 - <<'EOF_VALIDATE'
from api.shared.vertical_loader import active_runtime, validate_pack

runtime = active_runtime()
validate_pack(runtime.pack)
assert "{{WORKFLOW_TYPE}}" in runtime.pack.domains
print(
    f"    ok: {runtime.pack.name} owns "
    f"{runtime.pack.domains['{{WORKFLOW_TYPE}}'].display_name}"
)
EOF_VALIDATE

echo ""
echo "Restart FastAPI and Functions with:"
echo "  ZAVA_VERTICAL=$VERTICAL"
echo ""
echo "Verify composition:"
echo "  curl -s http://localhost:3101/api/blueprint/composition"
echo ""
echo "Record replay evidence into the active pack:"
echo "  curl -X POST http://localhost:3101/api/blueprint/_recorder/start"
echo "  # exercise {{WORKFLOW_TYPE}}"
echo "  curl -X POST http://localhost:3101/api/blueprint/_recorder/stop"
