{
  "name": "WPP Control Plane POC1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [5173, 3001, 7071],
  "portsAttributes": {
    "5173": { "label": "Vite UI", "onAutoForward": "openBrowser" },
    "3001": { "label": "FastAPI", "onAutoForward": "silent" },
    "7071": { "label": "Functions host", "onAutoForward": "silent" }
  },
  "remoteEnv": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-azurefunctions",
        "github.copilot",
        "ms-vscode.makefile-tools"
      ]
    }
  }
}
