{
  "name": "wpp-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:portal": "npm --prefix web/portal run dev",
    "build:portal": "npm --prefix web/portal run build",
    "dev:blueprint": "npm --prefix web/blueprint run dev",
    "build:blueprint": "npm --prefix web/blueprint run build",
    "dev:mcp": "concurrently -k -n wd,concur,mac \"tsx watch mocks/workday-mcp/server.ts\" \"tsx watch mocks/concur-mcp/server.ts\" \"tsx watch mocks/maconomy-mcp/server.ts\"",
    "demo:mcp": "concurrently -k -n wd,concur,mac \"tsx mocks/workday-mcp/server.ts\" \"tsx mocks/concur-mcp/server.ts\" \"tsx mocks/maconomy-mcp/server.ts\"",
    "dev:mcp:poc2": "concurrently -k -n gh,li,wdhr,grph,snow,acs,hg \"tsx watch mocks/greenhouse-mcp/server.ts\" \"tsx watch mocks/linkedin-mcp/server.ts\" \"tsx watch mocks/workday-hr-mcp/server.ts\" \"tsx watch mocks/graph-mcp/server.ts\" \"tsx watch mocks/servicenow-mcp/server.ts\" \"tsx watch mocks/acs-mcp/server.ts\" \"tsx watch mocks/heygen-mcp/server.ts\"",
    "demo:mcp:poc2": "concurrently -k -n gh,li,wdhr,grph,snow,acs,hg \"tsx mocks/greenhouse-mcp/server.ts\" \"tsx mocks/linkedin-mcp/server.ts\" \"tsx mocks/workday-hr-mcp/server.ts\" \"tsx mocks/graph-mcp/server.ts\" \"tsx mocks/servicenow-mcp/server.ts\" \"tsx mocks/acs-mcp/server.ts\" \"tsx mocks/heygen-mcp/server.ts\"",
    "demo:ui": "vite preview --host 0.0.0.0 --port 5173",
    "demo:portal": "npm --prefix web/portal run preview -- --host 0.0.0.0 --port 5174",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.60.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
