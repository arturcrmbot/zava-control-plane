---
title: System Context — Microsoft Agent Framework for WPP (C4 Level 1)
config:
  theme: base
  themeVariables:
    primaryColor: "#1168BD"
    primaryTextColor: "#FFFFFF"
    primaryBorderColor: "#0B4884"
    lineColor: "#5A5A5A"
    fontSize: "16px"
---
flowchart TB

  %% =========================================================
  %% C4 Level 1 — Context. One system box, external actors.
  %% =========================================================

  %% ---------- PEOPLE ----------
  subgraph PEOPLE["People"]
    direction TB
    emp["WPP Employee<br/><i>85,000+ users; receives<br/>agent outputs in M365 Copilot</i>"]
    hm["Hiring Manager<br/><i>Initiates hires from<br/>M365 Copilot</i>"]
    hrbp["HR Business Partner<br/><i>Operates Control Plane<br/>for hiring workflows</i>"]
    fc["Finance Controller<br/><i>Operates Control Plane<br/>for expense workflows</i>"]
    fbp["Finance Business Partner<br/><i>Approves budgets via<br/>email / Adaptive Cards</i>"]
    ssc["SSC Expense Reviewer<br/><i>Reviews AI-classified<br/>expense claims</i>"]
    itops["IT Operations<br/><i>Receives provisioning<br/>tickets in ServiceNow</i>"]
    plat["Platform Engineer<br/><i>Manages agent definitions,<br/>skills, policies via Git + APIOps</i>"]
    aud["Auditor (non-technical)<br/><i>Inspects agent authorisations,<br/>actions, rationale</i>"]
    cand(["Candidate (external)<br/><i>Web portal, voice, email</i>"])
  end

  %% ---------- OUR SYSTEM ----------
  subgraph WPPENT["WPP Enterprise"]
    maf(["<b>Microsoft Agent Framework for WPP</b><br/><br/>Unified agent runtime, Control Plane,<br/>governance and integration fabric<br/>for WPP's 85k+ workforce"]):::system
  end

  %% ---------- SURFACES ----------
  subgraph SURFACES["Agent Surfaces & Collaboration"]
    direction LR
    cop["Microsoft 365 Copilot<br/><i>Primary agent surface</i>"]
    m365["Microsoft 365<br/><i>Teams, Outlook, Word,<br/>Excel, SharePoint</i>"]
    acs["Azure Communication Services<br/><i>Voice / telephony (PSTN, SIP)</i>"]
    hg["HeyGen<br/><i>Avatar video rendering</i>"]
  end

  %% ---------- LoB SYSTEMS ----------
  subgraph LOB["Line-of-Business Systems"]
    direction LR
    workday["Workday HCM<br/><i>Staff identity<br/>source-of-truth</i>"]
    d365["Dynamics 365<br/><i>CRM + F&amp;O</i>"]
    sap["SAP BFC<br/><i>Finance consolidation</i>"]
    deltek["Deltek Maconomy<br/><i>Agency project finance</i>"]
    snow["ServiceNow<br/><i>ITSM, provisioning</i>"]
    gh["Greenhouse ATS<br/><i>Applicant tracking</i>"]
    li["LinkedIn Recruiter<br/><i>Talent sourcing</i>"]
  end

  %% ---------- DATA & IDENTITY ----------
  subgraph DATA["Data Platforms & Identity"]
    direction LR
    dbx["Databricks<br/><i>Primary data platform</i>"]
    sf["Snowflake<br/><i>Data platform</i>"]
    bq["BigQuery<br/><i>GCP data platform</i>"]
    dv["Dataverse<br/><i>Power Platform store</i>"]
    okta["Okta<br/><i>Federated identity broker</i>"]
  end

  %% ---------- A2A / OUT-OF-SCOPE BOUNDARY ----------
  subgraph A2A["Agent-to-Agent Interop (boundary)"]
    direction LR
    wppopen["WPP Open<br/><i>Separate WPP platform;<br/>A2A expected (out of RFP scope)</i>"]
    extagent["External Candidate AI Agent<br/><i>A2A interop for POC 2</i>"]
  end

  %% =========================================================
  %% RELATIONSHIPS
  %% =========================================================

  %% People -> Surfaces / System
  emp -- "Uses" --> cop
  emp -- "Works in" --> m365
  hm -- "Initiates hiring requests" --> cop
  fbp -- "Approves via Adaptive Cards" --> m365
  hrbp -- "Operates Control Plane" --> maf
  fc  -- "Operates Control Plane" --> maf
  ssc -- "Reviews AI-classified claims" --> maf
  itops -- "Actions tickets" --> snow
  plat -- "Git + APIOps: agent defs,<br/>skills, policies" --> maf
  aud -- "Read-only: authorisations,<br/>actions, rationale" --> maf
  cand -- "Engages (web, voice, email)" --> maf

  %% Surfaces -> System
  cop -- "Invokes agents via<br/>M365 Agents SDK" --> maf
  m365 -- "Adaptive Cards, drafts,<br/>documents" --> maf
  acs  -- "Voice channel" --- maf
  hg   -- "Avatar video" --- maf

  %% System -> LoB (MCP + OBO via Okta)
  maf -- "Worker / org data (MCP, OBO,<br/>SAML via Okta)" --> workday
  maf -- "CRM + F&amp;O (MCP, OBO)" --> d365
  maf -- "Posts finance txns (MCP)" --> sap
  maf -- "Project finance (MCP)" --> deltek
  maf -- "Creates provisioning tickets (MCP)" --> snow
  maf -- "Candidate records (MCP)" --> gh
  maf -- "Sources candidates (MCP)" --> li

  %% System -> Data & Identity
  maf -- "Queries data products (MCP)" --> dbx
  maf -- "Queries data products (MCP)" --> sf
  maf -- "Queries data products (MCP)" --> bq
  maf -- "Reads / writes (MCP)" --> dv
  maf -- "Federates identity<br/>(SAML / OIDC)" --> okta

  %% System -> A2A boundary (dotted)
  maf -. "A2A interop (future)" .-> wppopen
  maf -. "A2A with candidate agent (POC 2)" .-> extagent

  %% =========================================================
  %% STYLING
  %% =========================================================
  classDef person fill:#08427B,stroke:#052E56,color:#FFFFFF,rx:8,ry:8;
  classDef extperson fill:#686868,stroke:#3F3F3F,color:#FFFFFF,rx:8,ry:8;
  classDef system fill:#1168BD,stroke:#0B4884,color:#FFFFFF,stroke-width:3px,rx:12,ry:12;
  classDef ext fill:#999999,stroke:#6B6B6B,color:#FFFFFF,rx:6,ry:6;
  classDef a2a fill:#8B5A2B,stroke:#5A3A1C,color:#FFFFFF,rx:6,ry:6;

  class emp,hm,hrbp,fc,fbp,ssc,itops,plat,aud person;
  class cand extperson;
  class cop,m365,acs,hg,workday,d365,sap,deltek,snow,gh,li,dbx,sf,bq,dv,okta ext;
  class wppopen,extagent a2a;

  style WPPENT fill:#E8F1FB,stroke:#1168BD,stroke-width:2px,stroke-dasharray: 4 3
  style PEOPLE fill:#F5F7FA,stroke:#AAB3BD,stroke-dasharray: 2 3
  style SURFACES fill:#F5F7FA,stroke:#AAB3BD,stroke-dasharray: 2 3
  style LOB fill:#F5F7FA,stroke:#AAB3BD,stroke-dasharray: 2 3
  style DATA fill:#F5F7FA,stroke:#AAB3BD,stroke-dasharray: 2 3
  style A2A fill:#FBF4EC,stroke:#8B5A2B,stroke-dasharray: 2 3
