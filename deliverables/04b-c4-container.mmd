C4Container
  title Container Diagram — Microsoft Agent Framework for WPP (C4 Level 2)

  Person(ops, "Operator / HRBP / Finance Controller", "Runs fleet, approves exceptions")
  Person(plat, "Platform Engineer", "Git + APIOps")
  Person(aud, "Auditor", "Read-only inspection")
  Person_Ext(emp, "WPP Employee (via M365 Copilot)", "85k+ users; Agent Surface")

  System_Boundary(wpp, "Microsoft Agent Framework for WPP — Azure Landing Zone") {

    Boundary(net, "Network Edge (Private by default)") {
      Container(afd, "Azure Front Door Premium", "WAF / CDN", "Sole internet ingress; OWASP + bot rules")
      Container(apim, "APIM AI Gateway", "Azure API Management (GA)", "SOLE public edge for model + MCP + A2A traffic; token budgets, content safety, OBO")
      Container(apic, "Azure API Center", "API registry", "Unified registry: models, MCP tools, skills, APIs")
      Container(fw, "Azure Firewall Premium", "FQDN allow-list egress", "All outbound east/west via Private Endpoints")
    }

    Boundary(ui, "User-Facing Surfaces") {
      Container(cpui, "Custom Control Plane UI", "React SPA / Azure Static Web Apps", "Operator fleet view, approvals, autonomy config")
      Container(fcp, "Foundry Control Plane", "Azure AI Foundry portal (GA)", "Agent inventory, model registry, eval runs")
      Container_Ext(cop, "M365 Copilot", "Agent Surface (external)", "Primary employee channel; M365 Agents SDK")
    }

    Boundary(runtime, "Runtime Substrate") {
      Container(df, "Azure Durable Functions", "DF (.NET / Python) — GA", "Orchestration envelope — one instance per workflow; checkpoint, replay, HITL timers")
      Container(maf, "MAF Workflow", "Microsoft Agent Framework — GA", "Per-phase graph of typed executors; DF-integrated via Durable Task extension")
      Container(ghcp, "GHCP SDK Session", "Agents SDK (ephemeral)", "Invoked from MAF executor nodes; reasoning + tool-calling loop")
      Container(fha, "Foundry Hosted Agents", "Foundry Agent Service (preview)", "Container host for GHCP SDK sessions (Container Apps = GA fallback)")
      Container(fleet, "Fleet Manager Agents", "Foundry Hosted Agents — always-on", "Domain-scoped (Hiring / Finance / Compliance); observe + steer fleet")
    }

    Boundary(intel, "Intelligence Layer — MCP-addressable via APIM") {
      Container(fiq, "Foundry IQ", "Agentic retrieval (preview)", "Enterprise semantic search over curated corpora")
      Container(fabiq, "Fabric IQ", "Business semantic ontology (preview)", "Onelake-anchored semantic model")
      Container(wiq, "Work IQ MCP", "M365 work graph + memory (preview)", "People, meetings, emails, docs graph")
    }

    Boundary(data, "Data + State") {
      ContainerDb(cdb, "Cosmos DB", "NoSQL (SQL API)", "Workflow state, action ledger, autonomy config, approval records")
      ContainerDb(stor, "Azure Storage", "Blob + Table", "DF checkpoint persistence, immutable audit export (WORM)")
      Container(eg, "Azure Event Grid", "Event fabric", "DF ↔ hooks ↔ Fleet Manager pub/sub")
      Container(sr, "Azure SignalR", "Managed WebSocket", "Real-time push Fleet Manager → Control Plane UI")
      Container(obs, "Log Analytics + App Insights", "Azure Monitor", "Telemetry, audit trail, cost, traces, distributed spans")
    }

    Boundary(gov, "Governance Plane") {
      Container(entra, "Entra ID + Entra Agent ID", "Identity (GA)", "Agent identity, Conditional Access, OBO, RBAC")
      Container(a365, "Agent 365", "Lifecycle mgmt (GA May 2026)", "Agent registry, provisioning, retirement")
      Container(pv, "Purview", "DLP + labels + audit (GA)", "Sensitivity labels, DLP enforcement, unified audit")
      Container(def, "Defender for AI Services", "XDR (GA for Foundry)", "Prompt-injection, exfil, anomaly detection")
      Container(grd, "Foundry Guardrails", "Policy engine (preview)", "PII, Task Adherence, tool-call interception")
      Container(evl, "Foundry Evaluators", "Evaluation (GA)", "Quality, safety, drift scoring — CI + online")
    }
  }

  Boundary(ext_mcp, "External MCP Servers — via APIM") {
    System_Ext(mcp1, "Workday / Greenhouse / LinkedIn", "HR MCPs")
    System_Ext(mcp2, "ServiceNow / D365 F&O / Maconomy", "ITSM + Finance MCPs")
    System_Ext(mcp3, "Microsoft Graph / ACS / HeyGen", "M365 + voice + avatar MCPs")
    System_Ext(mcp4, "Logic Apps (citizen-dev MCPs)", "Long-tail connectors")
  }

